{
  "name": "droid-or",
  "version": "1.0.0",
  "description": "Install APKs and transfer apps between Android devices over ADB.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "desktopName": "droid.or.desktop",
  "author": {
    "name": "Óscar . Rentería Quevedo",
    "email": "rakzox@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "predev": "npm run generate:third-party-notices",
    "build": "npm run typecheck && electron-vite build",
    "prebuild": "npm run generate:third-party-notices",
    "generate:third-party-notices": "node scripts/generate-third-party-notices.mjs",
    "metrics": "node scripts/acquisition-metrics.mjs",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vicons/ionicons5": "0.13.0",
    "app-info-parser": "1.1.6",
    "better-sqlite3": "13.2.0",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "electron": "44.2.0",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "30.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14",
    "yazl": "3.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oscar-renteria/droid.or.git"
  },
  "homepage": "https://github.com/oscar-renteria/droid.or#readme",
  "bugs": {
    "url": "https://github.com/oscar-renteria/droid.or/issues"
  }
}
